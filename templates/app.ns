// ${name}: a Newton app. F7 builds ${name}.pkg, F5 runs it.
//
// newtc builds the package from what this file sets (newtc -build): the
// app's name, its icon, and theForm, its base view. Everything else has a
// sane default. NTK's names work: protoFloatNGo, vjParentCenterH, ...;
// kAppSymbol and kAppName (the label) are there once the name is set.
//
// newtc runs each statement on its own: a local doesn't reach the next one,
// a global (as greeting below) or a constant does. A bigger app can be
// split: Load("views.ns") runs that file (next to this one) here.

newtAppName := "${name}:SIG";           // the package's name; ":SIG" is your developer signature
newtAppLabel := "${name}";              // its name in Extras
newtAppIcon := MakeIconFromPNG({file: "icon.png", depth: 4});   // 16 grays, and black and white
newtAppCopyright := "Copyright ${year}";

newt.theForm := {
  _proto: protoFloatNGo,                // a floater with a close box
  viewBounds: {left: 0, top: 50, right: 200, bottom: 130},
  viewQuitScript: func() Print("Goodbye")
};

greeting := {
  _proto: protoStaticText,
  text: "Tap the button",
  viewBounds: {left: 10, top: 10, right: 190, bottom: 30}
};
AddStepForm(newt.theForm, greeting);
StepDeclare(newt.theForm, greeting, 'greeting);   // the button's script finds it as greeting

helloButton := {
  _proto: protoTextButton,
  text: "Say Hello",
  viewBounds: {left: 50, top: 40, right: 150, bottom: 60},
  buttonClickScript: func()
  begin
    SetValue(greeting, 'text, "Hello from " & kAppName & "!");
    Print(greeting.text);               // in VS Code's Debug Console
  end
};
AddStepForm(newt.theForm, helloButton);
