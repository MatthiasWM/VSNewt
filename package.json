{
  "name": "vsnewt",
  "displayName": "VSNewt",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDebugResolve:newtonscript",
    "onDebugDynamicConfigurations:newtonscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsnewt.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vsnewt.compile",
        "title": "Compile with VSNewt"
      },
      {
        "command": "vsnewt.compileGenerated",
        "title": "Compile with VSNewt for debugging"
      },
      {
        "command": "vsnewt.compileNsof",
        "title": "Compile NSOF with VSNewt"
      },
      {
        "command": "vsnewt.compileNsofGenerated",
        "title": "Compile NSOF with VSNewt for debugging"
      },
      {
        "command": "vsnewt.runNsof",
        "title": "Run NSOF with VSNewt"
      },
      {
        "command": "vsnewt.debugNsof",
        "title": "Debug NSOF with VSNewt"
      }
    ],
    "languages": [
      {
        "id": "newtonscript",
        "aliases": [
          "NewtonScript",
          "newtonscript"
        ],
        "extensions": [
          ".ns",
          ".newt",
          ".newtonscript"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "newtonscript-bytecode",
        "aliases": [
          "NewtonScript Bytecode"
        ],
        "extensions": [
          ".nsbc"
        ],
        "mimetypes": [
          "text/x-newtonscript-bytecode"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "newtonscript"
      },
      {
        "language": "newtonscript-bytecode"
      }
    ],
    "debuggers": [
      {
        "type": "newtonscript",
        "label": "NewtonScript",
        "languages": [
          "newtonscript",
          "newtonscript-bytecode"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "What to run: a NewtonScript file (.ns) is compiled and run; a package (.pkg) is loaded with its debug map and installed (its InstallScript runs).",
                "default": "${file}"
              },
              "newtc": {
                "type": "string",
                "description": "Path of the newtc executable. Default: the setting vsnewt.newtcPath, else the newtc that comes with the extension."
              },
              "log": {
                "type": "string",
                "description": "Write all Debug Adapter Protocol messages to this file (newtc -dap-log)."
              },
              "debugMap": {
                "type": "string",
                "description": "For a package: the debug map (.nsdbg, from `newtc -pkg <package> -odecompile <file.ns>`) that shows its functions in the decompiled source. Default: the .nsdbg next to the package with the same name, if there is one."
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "More newtc arguments, run in order before the program (e.g. [\"-pkg\", \"lib.pkg\", \"-nsdbg\", \"lib.nsdbg\"]). Not used with debugServer.",
                "default": []
              },
              "debugServer": {
                "type": "number",
                "description": "For working on newtc: connect to a newtc started as `newtc -dap-server <port>` (e.g. in a debugger) instead of starting one."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "newtonscript",
            "request": "launch",
            "name": "Run NewtonScript file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "NewtonScript: Run file",
            "description": "Run a NewtonScript file with newtc in the debugger.",
            "body": {
              "type": "newtonscript",
              "request": "launch",
              "name": "Run NewtonScript file",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "NewtonScript: Debug a package",
            "description": "Install a package in newtc and debug it in its decompiled source (newtc -pkg <package> -odecompile <name>.ns writes <name>.nsdbg).",
            "body": {
              "type": "newtonscript",
              "request": "launch",
              "name": "Debug package",
              "program": "^\"\\${workspaceFolder}/${1:app}.pkg\""
            }
          },
          {
            "label": "NewtonScript: Connect to newtc -dap-server",
            "description": "For working on newtc: run `newtc -dap-server 4711` (e.g. in lldb), then start this configuration.",
            "body": {
              "type": "newtonscript",
              "request": "launch",
              "name": "Run NewtonScript file (newtc -dap-server)",
              "program": "^\"\\${file}\"",
              "debugServer": 4711
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "VSNewt",
      "properties": {
        "vsnewt.newtcPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `newtc` executable, e.g. a development build. Empty: use the `newtc` that comes with the extension (`bin/<platform>-<arch>/newtc`)."
        }
      }
    },
    "grammars": [
      {
        "language": "newtonscript-bytecode",
        "scopeName": "source.newtonscript-bytecode",
        "path": "./syntaxes/newtonscript-bytecode.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && node scripts/package.mjs",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
