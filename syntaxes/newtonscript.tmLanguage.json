    "slots": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?![=?])(?!\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.property.newtonscript"
            },
            "2": {
              "name": "punctuation.separator.slot.newtonscript"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.newtonscript",
          "match": "\\bk[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.newtonscript",
          "match": ":="
        },
        {
          "name": "keyword.operator.string.newtonscript",
          "match": "&&|&"
        },
        {
          "name": "keyword.operator.bitwise.shift.newtonscript",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.newtonscript",
          "match": "<>|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.newtonscript",
          "match": "[-+*/]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.newtonscript",
          "match": "[,;]"
        },
        {
          "name": "punctuation.accessor.newtonscript",
          "match": "\\."
        }
      ]
    }
  }
}
