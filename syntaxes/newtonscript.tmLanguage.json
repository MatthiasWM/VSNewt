{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NewtonScript",
  "scopeName": "source.newtonscript",
  "comment": "Generated by scripts/make_grammar.py; edit that instead.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#slots"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.pragma.newtonscript",
          "match": "^\\s*//!.*$"
        },
        {
          "name": "comment.line.double-slash.newtonscript",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.newtonscript"
            }
          }
        },
        {
          "name": "comment.block.newtonscript",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.newtonscript"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.newtonscript",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.newtonscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.newtonscript"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.unicode.newtonscript",
              "match": "\\\\u(?:[0-9A-Fa-f]{4})*\\\\u"
            },
            {
              "name": "constant.character.escape.newtonscript",
              "match": "\\\\[\\\\\"nt]"
            },
            {
              "name": "invalid.illegal.escape.newtonscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.newtonscript",
          "match": "\\$(?:\\\\u[0-9A-Fa-f]{4}|\\\\[0-9A-Fa-f]{2}|\\\\[\\\\nt]|[^\\s\\\\])"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.newtonscript",
          "match": "'\\|[^|]*\\|"
        },
        {
          "name": "constant.other.symbol.newtonscript",
          "match": "'[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.quoted.newtonscript",
          "match": "\\|[^|\\n]*\\|"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.newtonscript",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.newtonscript",
          "match": "(?:\\b[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][-+]?[0-9]+)?\\b"
        },
        {
          "name": "constant.other.magic-pointer.newtonscript",
          "match": "@[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.newtonscript",
          "match": "(?i)\\b(?:if|then|else|for|foreach|to|by|do|in|deeply|collect|while|repeat|until|loop|break|return|try|onexception|begin|end|call|with)\\b"
        },
        {
          "name": "storage.type.newtonscript",
          "match": "(?i)\\b(?:func|native|local|global|constant)\\b"
        },
        {
          "name": "keyword.operator.word.newtonscript",
          "match": "(?i)\\b(?:and|or|not|div|mod|exists)\\b"
        },
        {
          "name": "variable.language.newtonscript",
          "match": "(?i)\\b(?:self|inherited)\\b"
        },
        {
          "name": "constant.language.newtonscript",
          "match": "(?i)\\b(?:nil|true)\\b"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(?i)\\b(global)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.type.newtonscript"
            },
            "2": {
              "name": "entity.name.function.newtonscript"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*(?i:func|native)\\b)",
          "captures": {
            "1": {
              "name": "entity.name.function.newtonscript"
            },
            "2": {
              "name": "punctuation.separator.slot.newtonscript"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(:\\??)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.send.newtonscript"
            },
            "2": {
              "name": "entity.name.function.method.newtonscript"
            }
          }
        },
        {
          "name": "support.function.builtin.newtonscript",
          "match": "(?i)\\b(?:AbortCardAlerts|abs|acos|acosh|ActivatePackage|ActivateStorePackages|ActivateTestAgent|AddAlarm|AddAlarmInSeconds|AddArraySlot|AddAutoAdd|AddDeferredAction|AddDeferredCall|AddDeferredSend|AddDelayedAction|AddDelayedCall|AddDelayedSend|AddDictionary|AddEmporium|AddFolder|AddHist|AddInk|AddLexFrame|AddLocale|AddMemoryItem|AddMemoryItemUnique|AddModemSetUp|AddPersona|AddPowerOffHandler|AddPrecludedCall|AddPrecludedSend|AddProcrastinatedCall|AddProcrastinatedSend|AddStepView|AddToSysSoup|AddToUserDictionary|AddTryString|AddUndoAction|AddUndoCall|AddUndoSend|AddView|AddWordToDictionary|AlarmUser|AliasFromObj|and|AnimateSimpleStroke|AnnoyUser|AnnoyUserRepeatedly|annuity|Append|AppendList|AppInstalled|AppleTalkOpenCount|Apply|Aref|array|ArrayInsert|ArrayMunger|ArrayPos|ArrayRemoveCount|ArrayToPoints|asin|asinh|AsyncConfirm|atan|atan2|atanh|AutoDock|BackLight|BackLightStatus|BackupBatteryCheck|BackupPatchPackage|BadAdapterAlert|BadBatteryAlert|BadWickedNaughtyNoot|band|BatteryCount|BatteryLevel|BatteryRawStatus|BatteryStatus|BDelete|BDifference|BeginsWith|BFetch|BFetchRight|BFind|BFindRight|BHNotify|BinaryMunger|BinEqual|BInsert|BInsertRight|BIntersect|BlockStrokes|BMerge|bnot|BookAvailable|BookRemoved|BootSucceeded|bor|BreakLoop|BroadcastSoupChange|BSearchLeft|BSearchRight|BubbleArraySlot|BuildContext|BuildRecConfig|BusyBoxControl|bxor|CalcBundleBounds|CalcInkBounds|CalibrateTablet|CallFrameBasedRegistryFns|CallOnlineService|CallPowerOnFns|CallPowerStatusChangeFns|CallWithStrokesOff|CancelOnlineService|Capitalize|CapitalizeWords|CardAlert|CategorizeKeyCommands|ceiling|CharPos|CheckCardBattery|CheckThatFolderExists|CHR|CircleDistance|ClassAppByClass|ClassInfoByName|ClassInfoRegistryNext|ClassInfoRegistrySeed|ClassOf|CleanString|ClearHardKeymap|ClearPopup|clearPopupMark|ClearTryString|ClearUndoStacks|ClearVBOCache|Clicker|ClickLetterScript|Clone|CloseAppleTalk|ClosedEntryForm|CloseRemoteControl|ClosestLocations|CloseStoreSlip|CodeForLine|collect